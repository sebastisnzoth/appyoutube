YOUTUBE_API_KEY=tu_api_key
PORT=8000

# Google OAuth web app credentials
GOOGLE_OAUTH_CLIENT_ID=tu_client_id
GOOGLE_OAUTH_CLIENT_SECRET=tu_client_secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/auth/youtube/callback

# Flask session signing secret
FLASK_SECRET_KEY=cambia_esto_por_un_secreto_largo

# Fernet key for encrypting OAuth credentials at rest.
# Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=pega_aqui_la_clave_fernet

# Optional: maximum uploaded video size in bytes. Default: 2 GiB.
# MAX_UPLOAD_BYTES=2147483648
